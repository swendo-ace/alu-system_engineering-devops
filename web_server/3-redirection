#!/usr/bin/env bash
# Installs nginx and configures /redirect_me to return a 301 Moved Permanently
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
if ! grep -q "redirect_me" /etc/nginx/sites-available/default; then
    sed -i 's|server_name _;|server_name _;\n\trewrite ^/redirect_me https://github.com/swendo-ace permanent;|' /etc/nginx/sites-available/default
fi
service nginx restart
